{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolhead.technology/schemas/waiver.schema.json",
  "title": "PerScannerWaiver",
  "description": "Repo-local waiver for exactly one scanner. File must be security/waivers/<scanner_id>.yaml. No central multi-scanner bag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scanner_id",
    "check_id",
    "reason",
    "owner",
    "ticket",
    "expires_on"
  ],
  "properties": {
    "scanner_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "description": "Must match file stem security/waivers/<scanner_id>.yaml"
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "description": "Same as scanner_id for baseline scanners."
    },
    "reason": {
      "type": "string",
      "minLength": 20,
      "description": "Why this scanner is waived; no secrets."
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "string",
      "minLength": 3,
      "description": "repo#n or issue URL"
    },
    "expires_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "UTC date YYYY-MM-DD; past dates fail closed"
    },
    "created_utc": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "description": "Optional path glob; default whole repo"
    },
    "findings_allowed": {
      "description": "Optional cap or list of allowed finding fingerprints (not secret values).",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    }
  }
}
